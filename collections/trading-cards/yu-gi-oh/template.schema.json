{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yu-Gi-Oh! TCG card attributes",
  "type": "object",
  "properties": {
    "number": {
      "description": "Full printed Card Number, e.g. LOB-EN001. Early North American printings carry no region code (LOB-001); Sneak Preview and Special Edition cards use letter-suffixed positions (LOB-ENSP1). Pattern is deliberately permissive across all three forms.",
      "type": "string",
      "pattern": "^[A-Z0-9]{2,6}-[A-Z]{0,4}[0-9]{1,3}$"
    },
    "rarity": {
      "description": "TCG rarities only — OCG-exclusive rarities (Millennium, Kaiba Corporation, Rush/Over Rush) don't appear on TCG cards. Expected to grow; add a confirmed missing rarity in the same PR as the card that needs it.",
      "type": "string",
      "enum": [
        "Common",
        "Short Print",
        "Super Short Print",
        "Normal Rare",
        "Rare",
        "Super Rare",
        "Ultra Rare",
        "Secret Rare",
        "Ultimate Rare",
        "Ghost Rare",
        "Parallel Rare",
        "Normal Parallel Rare",
        "Super Parallel Rare",
        "Ultra Parallel Rare",
        "Secret Parallel Rare",
        "Duel Terminal Normal Parallel Rare",
        "Duel Terminal Rare Parallel Rare",
        "Duel Terminal Super Parallel Rare",
        "Duel Terminal Ultra Parallel Rare",
        "Duel Terminal Secret Parallel Rare",
        "Starfoil Rare",
        "Mosaic Rare",
        "Shatterfoil Rare",
        "Holographic Rare",
        "Gold Rare",
        "Gold Secret Rare",
        "Premium Gold Rare",
        "Ghost/Gold Rare",
        "Platinum Rare",
        "Platinum Secret Rare",
        "Prismatic Secret Rare",
        "Extra Secret Rare",
        "Ultra Secret Rare",
        "Secret Ultra Rare",
        "Collector's Rare",
        "Starlight Rare",
        "Quarter Century Secret Rare",
        "10000 Secret Rare",
        "20th Secret Rare"
      ]
    }
  },
  "required": [
    "number"
  ],
  "additionalProperties": false
}
