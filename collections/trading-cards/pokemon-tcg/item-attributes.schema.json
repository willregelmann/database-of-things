{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pokemon TCG card attributes",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "pattern": "^[0-9]+/[0-9]+$"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "ACE SPEC Rare",
        "Amazing Rare",
        "Black White Rare",
        "Common",
        "Common Holo",
        "Double Rare",
        "Hyper Rare",
        "Illustration Rare",
        "Mega Attack Rare",
        "Mega Hyper Rare",
        "Promo",
        "Radiant Rare",
        "Rare",
        "Rare Ace",
        "Rare BREAK",
        "Rare Classic",
        "Rare Holo",
        "Rare Holo GX",
        "Rare Holo LEGEND",
        "Rare Holo LV.X",
        "Rare Holo Prime",
        "Rare Holo V",
        "Rare Holo VMAX",
        "Rare Holo VSTAR",
        "Rare Holo ex",
        "Rare Holo ☆",
        "Rare Prism Star",
        "Rare Rainbow",
        "Rare Secret",
        "Rare Shining",
        "Rare Shiny",
        "Rare Shiny GX",
        "Rare Ultra",
        "Shining Holofoil",
        "Shiny Rare",
        "Shiny Ultra Rare",
        "Special Illustration Rare",
        "Trainer Gallery Rare Holo",
        "Ultra Rare",
        "Uncommon"
      ]
    },
    "illustrator": {
      "type": "string"
    },
    "type": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Colorless",
          "Darkness",
          "Dragon",
          "Fairy",
          "Fighting",
          "Fire",
          "Grass",
          "Lightning",
          "Metal",
          "Psychic",
          "Water"
        ]
      }
    }
  }
}
