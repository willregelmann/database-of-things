{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power Rangers — default attributes",
  "type": "object",
  "properties": {
    "number": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "Standard",
        "Movie Edition",
        "Special Edition",
        "Store Exclusive"
      ]
    },
    "exclusive_to": {
      "type": "string"
    },
    "zordComponents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of the individual Zords a Megazord physically combines from, when Bandai never sold them as separate products. Record only where a source specifically documents the exact pieces."
    }
  },
  "required": [
    "manufacturer"
  ]
}
