{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Power Rangers \u2014 default attributes",
  "type": "object",
  "properties": {
    "number": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "manufacturer": {
      "type": "string"
    },
    "variant": {
      "type": "string",
      "enum": [
        "Standard",
        "Movie Edition",
        "Special Edition",
        "Store Exclusive"
      ]
    },
    "exclusive_to": {
      "type": "string"
    }
  },
  "required": [
    "manufacturer"
  ],
  "additionalProperties": false
}
